# Variable para Vite (build-time) — dejar vacío para que axios use URLs relativas
# y el proxy de Vite (dev) o nginx (prod) haga el proxy hacia el backend.
VITE_API_URL=

# IP pública del backend (usada por nginx en producción con docker compose)
# Reemplazar con la IP real antes de correr docker compose
BACKEND_URL=http://REEMPLAZAR_CON_IP_BACKEND:8080
