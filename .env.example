# ================================================================
# Donatech Frontend — Variables de entorno
# Copiar este archivo a .env y completar los valores reales.
# ================================================================

# URL del API Gateway al que nginx proxea /api (uso interno del contenedor).
# En el compose cloud se fija a http://api-gateway:8080 (red interna, Caddy expone el TLS).
# Para el frontend standalone local: http://host.docker.internal:8080
BACKEND_URL=http://host.docker.internal:8080
