# ================================================================
# nginx.conf.template — Donatech Frontend
#
# Este archivo es un TEMPLATE. Al iniciar el contenedor, nginx
# reemplaza ${BACKEND_URL} con el valor real de la variable de entorno.
#
# Ejemplo: BACKEND_URL=http://54.123.45.67:8080
# ================================================================

server {
    listen 80;
    server_name _;

    # Directorio donde están los archivos compilados de React
    root /usr/share/nginx/html;
    index index.html;

    # Permite subir comprobantes/imágenes de varios MB (default nginx = 1 MB → 413)
    client_max_body_size 15m;

    # ── Proxy de API al backend ───────────────────────────────
    # Todas las llamadas a /api/* se reenvían al API Gateway del backend.
    # El frontend React hace llamadas relativas (/api/auth/login, etc.)
    # y nginx las redirige a la EC2 del backend.
    location /api/ {
        # CORS — nginx responde preflight y añade headers en todas las respuestas.
        # Esto permite cualquier origen (tunnels, EC2, localhost) sin cambiar el backend.
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin'      $http_origin always;
            add_header 'Access-Control-Allow-Credentials' 'true'       always;
            add_header 'Access-Control-Allow-Methods'     'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers'     'Authorization, Content-Type, Accept, X-Requested-With' always;
            add_header 'Access-Control-Max-Age'           '86400'      always;
            add_header 'Content-Length' 0;
            return 204;
        }

        add_header 'Access-Control-Allow-Origin'      $http_origin always;
        add_header 'Access-Control-Allow-Credentials' 'true'       always;

        # Ocultar headers CORS del backend para evitar duplicados
        proxy_hide_header 'Access-Control-Allow-Origin';
        proxy_hide_header 'Access-Control-Allow-Credentials';
        proxy_hide_header 'Access-Control-Allow-Methods';
        proxy_hide_header 'Access-Control-Allow-Headers';

        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin            "";

        proxy_connect_timeout 60s;
        # Llamadas al LLM (kit-ia con Ollama en CPU) pueden tardar minutos
        proxy_read_timeout    200s;
        proxy_send_timeout    200s;

        proxy_intercept_errors off;
    }

    # ── Archivos estáticos de React ───────────────────────────
    # Maneja el enrutamiento del lado del cliente (React Router).
    # Si el archivo no existe, sirve index.html para que React Router
    # maneje la ruta.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Caché para assets estáticos ───────────────────────────
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ── Seguridad básica ─────────────────────────────────────
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    # Ocultar versión de nginx
    server_tokens off;
}
