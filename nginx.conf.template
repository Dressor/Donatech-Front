# ================================================================
# nginx.conf.template — Donatech Frontend
#
# Este archivo es un TEMPLATE. Al iniciar el contenedor, nginx
# reemplaza ${BACKEND_URL} con el valor real de la variable de entorno.
#
# Ejemplo: BACKEND_URL=http://54.123.45.67:8080
# ================================================================

server {
    listen 80;
    server_name _;

    # Directorio donde están los archivos compilados de React
    root /usr/share/nginx/html;
    index index.html;

    # ── Proxy de API al backend ───────────────────────────────
    # Todas las llamadas a /api/* se reenvían al API Gateway del backend.
    # El frontend React hace llamadas relativas (/api/auth/login, etc.)
    # y nginx las redirige a la EC2 del backend.
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_http_version 1.1;

        # Headers necesarios para que el backend sepa el origen real
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts (los microservicios Java pueden tardar en responder)
        proxy_connect_timeout 60s;
        proxy_read_timeout    60s;
        proxy_send_timeout    60s;

        # Manejo de errores del backend
        proxy_intercept_errors off;
    }

    # ── Archivos estáticos de React ───────────────────────────
    # Maneja el enrutamiento del lado del cliente (React Router).
    # Si el archivo no existe, sirve index.html para que React Router
    # maneje la ruta.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Caché para assets estáticos ───────────────────────────
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ── Seguridad básica ─────────────────────────────────────
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    # Ocultar versión de nginx
    server_tokens off;
}
